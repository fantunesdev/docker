# Copie para .env.dev. O comando deve incluir --env-file .env.dev.
# Caminhos relativos à pasta docker; use caminhos absolutos para outras estruturas.
MYFINANCE_PATH=../myfinance
CLASSIFIER_PATH=../transaction_classifier
# Se renomear o repositório para transaction-classifier, ajuste CLASSIFIER_PATH.
# Dockerfile relativo a cada contexto de build; um caminho absoluto também funciona.
DEV_DOCKERFILE=../docker/Dockerfile.dev
# Em Linux, use host se o DNS falhar apenas durante o build.
DEV_BUILD_NETWORK=default

# Use os valores de id -u e id -g para evitar arquivos criados como root.
DEV_UID=1000
DEV_GID=1000
MYFIN_DEV_PORT=8000
CLASSIFIER_DEV_PORT=8112

DEV_SECRET_KEY=myfinance-development-only-secret-key-change-for-other-environments
DEV_MYSQL_PASSWORD=myfinance-dev
DEV_MYSQL_ROOT_PASSWORD=myfinance-dev-root

# Preencher depois de cadastrar uma aplicação OAuth2 no banco de desenvolvimento.
DEV_CLASSIFIER_CLIENT_ID=
DEV_CLASSIFIER_CLIENT_SECRET=
