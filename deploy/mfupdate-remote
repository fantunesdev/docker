#!/bin/bash

set -eu

UPDATE_MYFINANCE=false
UPDATE_TC=false
UPDATE_DOCKER=false
for ARG in "$@"; do
    case "$ARG" in
        -a) UPDATE_MYFINANCE=true; UPDATE_TC=true; UPDATE_DOCKER=true ;;
        -tc) UPDATE_TC=true ;;
        -d) UPDATE_DOCKER=true ;;
        -h|--help)
            echo 'Uso: mfupdate [-a] [-tc] [-d]'
            echo 'Sem argumentos: publica o MyFinance na VM.'
            echo '-a: atualiza somente as branches atuais de MyFinance, transaction_classifier e Docker na VM.'
            echo '-tc: atualiza somente a branch atual de transaction_classifier na VM.'
            echo '-d: atualiza somente a branch atual do repositório Docker na VM.'
            echo 'As opções podem ser combinadas; não fazem build nem reiniciam serviços.'
            exit 0 ;;
        *) echo "Argumento desconhecido: $ARG. Use mfupdate --help." >&2; exit 1 ;;
    esac
done

if [ "$#" -gt 0 ]; then
    # Não chama o mfupdate remoto: versões antigas ignoram flags e fazem deploy.
    REMOTE_BODY=$(cat <<'REMOTE'
BASEDIR="${BASEDIR:-/docker/myfinance}"
STATE="$BASEDIR/.mfdeploy"
mkdir -p "$STATE"
if ! mkdir "$STATE/lock" 2>/dev/null; then
    echo 'Outro mfupdate está em execução (ou deixou .mfdeploy/lock).' >&2
    exit 1
fi
trap 'rmdir "$STATE/lock"' 0
trap 'exit 130' INT
trap 'exit 143' TERM
if [ "$UPDATE_MYFINANCE" = true ]; then
    echo 'Atualizando a branch atual de MyFinance...'
    git -C "$BASEDIR/myfinance" pull --ff-only
fi
if [ "$UPDATE_TC" = true ]; then
    echo 'Atualizando a branch atual de transaction_classifier...'
    git -C "$BASEDIR/transaction_classifier" pull --ff-only
fi
if [ "$UPDATE_DOCKER" = true ]; then
    echo 'Atualizando a branch atual do repositório Docker...'
    git -C "$BASEDIR" pull --ff-only
fi
REMOTE
)
    REMOTE_COMMAND="set -eu
UPDATE_MYFINANCE=$UPDATE_MYFINANCE
UPDATE_TC=$UPDATE_TC
UPDATE_DOCKER=$UPDATE_DOCKER
$REMOTE_BODY"
    exec ssh -t producao "$REMOTE_COMMAND"
fi

REMOTE_COMMAND=$(cat <<'REMOTE'
set -eu

BASEDIR="${BASEDIR:-/docker/myfinance}"
BASEDIR="$BASEDIR" "$BASEDIR/mfupdate"

# Conta os commits do código atualizado no servidor.
NEW_VERSION=$(git -C "$BASEDIR/myfinance" rev-list --count HEAD)

# Usa o slot que o deploy acabou de ativar para registrar a versão no banco.
ACTIVE_SLOT=$(cat "$BASEDIR/.mfdeploy/active")
case "$ACTIVE_SLOT" in
    blue|green) ;;
    *) echo 'Slot ativo inválido após a atualização.' >&2; exit 1 ;;
esac
BASEDIR="$BASEDIR" "$BASEDIR/mfcompose" exec -T "app-myfin-$ACTIVE_SLOT" python - "$NEW_VERSION" <<'PY'
import os
import sys

os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'myfinance.settings')
import django
django.setup()

from django.utils import timezone
from statement.models import Version

version = f'v2.0.{int(sys.argv[1])}'
latest = Version.objects.order_by('-id').first()
if latest is None or latest.version != version:
    Version.objects.create(version=version, date=timezone.localdate())
    print(f'Versão registrada: {version}')
else:
    print(f'Versão {version} já registrada.')
PY
REMOTE
)

ssh -t producao "$REMOTE_COMMAND"
