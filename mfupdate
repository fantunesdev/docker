#!/bin/sh
set -eu

BASEDIR="${BASEDIR:-/docker/myfinance}"
UPDATE_MYFINANCE=false
UPDATE_TC=false
UPDATE_DOCKER=false
for ARG in "$@"; do
    case "$ARG" in
        -a) UPDATE_MYFINANCE=true; UPDATE_TC=true; UPDATE_DOCKER=true ;;
        -tc) UPDATE_TC=true ;;
        -d) UPDATE_DOCKER=true ;;
        -h|--help)
            echo 'Uso: mfupdate [-a] [-tc] [-d]'
            echo 'Sem argumentos: publica o MyFinance pelo fluxo habitual.'
            echo '-a: atualiza somente as branches atuais de MyFinance, transaction_classifier e Docker.'
            echo '-tc: atualiza somente a branch atual de transaction_classifier.'
            echo '-d: atualiza somente a branch atual do repositório Docker.'
            echo 'As opções podem ser combinadas; não fazem build nem reiniciam serviços.'
            exit 0 ;;
        *) echo "Argumento desconhecido: $ARG. Use mfupdate --help." >&2; exit 1 ;;
    esac
done
if [ "$UPDATE_TC" = true ] || [ "$UPDATE_DOCKER" = true ]; then
    # O shell filho lê todo o programa antes do pull: -d pode alterar este arquivo.
    # Usa o mesmo lock do deploy para não atualizar a infraestrutura durante uma troca.
    exec sh -eu -c '
        basedir=$1
        update_tc=$2
        update_docker=$3
        update_myfinance=$4
        state="$basedir/.mfdeploy"
        mkdir -p "$state"
        if ! mkdir "$state/lock" 2>/dev/null; then
            echo "Outro mfupdate está em execução (ou deixou .mfdeploy/lock)." >&2
            exit 1
        fi
        trap '\''rmdir "$state/lock"'\'' 0
        trap '\''exit 130'\'' INT
        trap '\''exit 143'\'' TERM
        if [ "$update_myfinance" = true ]; then
            echo "Atualizando a branch atual de MyFinance..."
            git -C "$basedir/myfinance" pull --ff-only
        fi
        if [ "$update_tc" = true ]; then
            echo "Atualizando a branch atual de transaction_classifier..."
            git -C "$basedir/transaction_classifier" pull --ff-only
        fi
        if [ "$update_docker" = true ]; then
            echo "Atualizando a branch atual do repositório Docker..."
            git -C "$basedir" pull --ff-only
        fi
    ' sh "$BASEDIR" "$UPDATE_TC" "$UPDATE_DOCKER" "$UPDATE_MYFINANCE"
fi
TEST_TIMEOUT="${TEST_TIMEOUT:-60}"
DRAIN_TIMEOUT="${DRAIN_TIMEOUT:-60}"
BACKUP_KEEP="${BACKUP_KEEP:-3}"
DEPLOY_IMAGE="${DEPLOY_IMAGE:-}"
DEPLOY_COMMIT="${DEPLOY_COMMIT:-}"
if [ -n "$DEPLOY_IMAGE" ]; then
    printf '%s\n' "$DEPLOY_COMMIT" | grep -Eq '^[0-9a-f]{40}$' || {
        echo 'DEPLOY_COMMIT precisa ser um SHA Git completo.' >&2; exit 1;
    }
    printf '%s\n' "$DEPLOY_IMAGE" | grep -Eq '^ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$' || {
        echo 'DEPLOY_IMAGE precisa ser uma imagem GHCR fixada por digest.' >&2; exit 1;
    }
elif [ -n "$DEPLOY_COMMIT" ]; then
    echo 'DEPLOY_COMMIT requer DEPLOY_IMAGE; não será construído outro código no servidor.' >&2
    exit 1
fi
DEPLOY_ID="$(date +%Y%m%d-%H%M%S)-$$"
BKP_IMAGE="docker_myfinance_app-myfin-bkp:$DEPLOY_ID"
RELEASE_IMAGE="myfinance-release:$DEPLOY_ID"
TEST_CONTAINER="myfinance-update-test-$$"
MIGRATION_BACKUP_TEMP=''
CANDIDATE=''
SWITCHING=false
COMMITTED=false
LOCKED=false

for VALUE in "$TEST_TIMEOUT" "$DRAIN_TIMEOUT" "$BACKUP_KEEP"; do
    case "$VALUE" in ''|0*|*[!0-9]*)
        echo 'TEST_TIMEOUT, DRAIN_TIMEOUT e BACKUP_KEEP devem ser inteiros positivos.' >&2
        exit 1 ;;
    esac
done
cd "$BASEDIR"
STATE="$BASEDIR/.mfdeploy"
mkdir -p "$STATE"
if ! mkdir "$STATE/lock" 2>/dev/null; then
    echo 'Outro mfupdate está em execução (ou deixou .mfdeploy/lock após uma interrupção abrupta).' >&2
    exit 1
fi
LOCKED=true
if docker compose version >/dev/null 2>&1; then COMPOSE_V2=true; else COMPOSE_V2=false; fi
compose() {
    if [ "$COMPOSE_V2" = true ]; then
        docker compose -f "$BASEDIR/docker-compose.yml" "$@"
    else
        docker-compose -f "$BASEDIR/docker-compose.yml" "$@"
    fi
}
current_compose() { BASEDIR="$BASEDIR" "$BASEDIR/mfcompose" "$@"; }
candidate_compose() { compose --profile "$NEXT" -f "$STATE/$NEXT.yml" "$@"; }

clean_docker_images() {
    echo "Limpando Docker; mantendo o backup atual e até $BACKUP_KEEP backups no total..."

    # Os nomes têm data/hora ordenável. Sempre preserva o backup desta execução,
    # mesmo se o relógio da VM tiver mudado desde o último deploy.
    if BACKUP_TAGS=$(docker image ls \
        --filter 'reference=docker_myfinance_app-myfin-bkp:*' \
        --format '{{.Repository}}:{{.Tag}}'); then
        BACKUP_TAGS=$(printf '%s\n' "$BACKUP_TAGS" | LC_ALL=C sort -ru)
        KEPT_BACKUPS=1
        for BACKUP_TAG in $BACKUP_TAGS; do
            [ "$BACKUP_TAG" = "$BKP_IMAGE" ] && continue
            if [ "$KEPT_BACKUPS" -lt "$BACKUP_KEEP" ]; then
                KEPT_BACKUPS=$((KEPT_BACKUPS + 1))
                continue
            fi
            # Sem --force: referências em uso não devem ser forçadas à remoção.
            docker image rm "$BACKUP_TAG" || \
                echo "Aviso: não foi possível remover $BACKUP_TAG." >&2
        done
    else
        echo 'Aviso: não foi possível listar os backups antigos.' >&2
    fi

    # As duas referências persistidas precisam sobreviver também a um reboot.
    if RELEASE_TAGS=$(docker image ls --filter 'reference=myfinance-release:*' --format '{{.Repository}}:{{.Tag}}'); then
        for RELEASE_TAG in $RELEASE_TAGS; do
            [ "$RELEASE_TAG" = "$RELEASE_IMAGE" ] && continue
            if ! grep -F -q "image: $RELEASE_TAG" "$STATE/blue.yml" "$STATE/green.yml" 2>/dev/null; then
                docker image rm "$RELEASE_TAG" || echo "Aviso: não foi possível remover $RELEASE_TAG." >&2
            fi
        done
    fi

    # A limpeza global de imagens/cache pertence à manutenção do host.
}

cleanup() {
    STATUS=$?
    trap - 0 INT TERM
    set +e
    if [ "$SWITCHING" = true ] && [ "$COMMITTED" != true ]; then
        echo 'Restaurando o destino anterior do Nginx...' >&2
        cp "$STATE/previous-nginx.conf" "$STATE/nginx/default.conf"
        if [ "$ACTIVE" = legacy ]; then rm -f "$STATE/active";
        else printf '%s\n' "$ACTIVE" > "$STATE/active"; fi
        docker update --restart=unless-stopped "$CURRENT_CONTAINER" >/dev/null
        if ! docker exec nginx-myfin nginx -t || ! docker exec nginx-myfin nginx -s reload; then
            echo 'Falha ao restaurar o Nginx; os dois aplicativos foram preservados para recuperação manual.' >&2
            CANDIDATE=''
        fi
    fi
    if [ "$COMMITTED" != true ] && [ -n "$CANDIDATE" ]; then
        docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
    fi
    docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
    [ -z "$MIGRATION_BACKUP_TEMP" ] || rm -f "$MIGRATION_BACKUP_TEMP"
    if [ "$COMMITTED" = true ] && [ "$STATUS" -ne 0 ]; then
        echo "O novo slot $NEXT está ativo, mas a finalização falhou. Verifique o worker e o container antigo." >&2
    fi
    if [ "$LOCKED" = true ]; then rmdir "$STATE/lock"; fi
    exit "$STATUS"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM

ACTIVE=legacy
if [ -f "$STATE/active" ]; then ACTIVE=$(cat "$STATE/active"); fi
case "$ACTIVE" in
    legacy) CURRENT_SERVICE=app-myfin; NEXT=blue; PREVIOUS=legacy ;;
    blue) CURRENT_SERVICE=app-myfin-blue; NEXT=green; PREVIOUS=blue ;;
    green) CURRENT_SERVICE=app-myfin-green; NEXT=blue; PREVIOUS=green ;;
    *) echo 'Estado de deploy inválido.' >&2; exit 1 ;;
esac
CURRENT_CONTAINER=$(current_compose ps -q "$CURRENT_SERVICE")
if [ -z "$CURRENT_CONTAINER" ] || [ "$(docker inspect --format '{{.State.Running}}' "$CURRENT_CONTAINER")" != true ]; then
    echo 'A aplicação atual precisa estar em execução para validar a atualização.' >&2
    exit 1
fi
ACTUAL_IMAGE=$(docker inspect --format '{{.Image}}' "$CURRENT_CONTAINER")
docker tag "$ACTUAL_IMAGE" "$BKP_IMAGE"
echo "Backup da imagem atual: $BKP_IMAGE"
clean_docker_images

if [ -n "$DEPLOY_IMAGE" ]; then
    # Confere a proveniência antes de tocar no slot inativo ou no banco.
    docker pull "$DEPLOY_IMAGE"
    IMAGE_COMMIT=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$DEPLOY_IMAGE")
    if [ "$IMAGE_COMMIT" != "$DEPLOY_COMMIT" ]; then
        echo 'O commit da imagem não corresponde ao commit aprovado pelo CI.' >&2; exit 1
    fi
    IMAGE_INFRA=$(docker image inspect --format '{{index .Config.Labels "io.myfinance.infrastructure.revision"}}' "$DEPLOY_IMAGE")
    if [ "$IMAGE_INFRA" != "$(git rev-parse HEAD)" ]; then
        echo 'A infraestrutura da VM difere da usada no CI. Atualize o checkout antes de publicar.' >&2; exit 1
    fi
    VALIDATED_IMAGE=$(docker image inspect --format '{{.Id}}' "$DEPLOY_IMAGE")
else
    git -C myfinance pull --ff-only
    compose --profile legacy build --no-cache app-myfin
    VALIDATED_IMAGE=$(docker image inspect --format '{{.Id}}' myfinance-app-myfin)
fi
docker tag "$VALIDATED_IMAGE" "$RELEASE_IMAGE"
if [ "$NEXT" = blue ]; then NEXT_IP=172.18.0.8; else NEXT_IP=172.18.0.9; fi
# Nunca remove o slot ativo. O inativo pode ter sobrado de uma execução interrompida.
docker rm -f "app-myfin-$NEXT" >/dev/null 2>&1 || true
mkdir -p "$STATE/assets/$NEXT/static" "$STATE/nginx"
cat > "$STATE/$NEXT.yml" <<YAML
services:
  app-myfin-$NEXT:
    image: $RELEASE_IMAGE
  investment-history:
    image: $RELEASE_IMAGE
  password-reset-email:
    image: $RELEASE_IMAGE
  nginx-myfin:
    volumes:
      - $STATE/nginx:/etc/nginx/conf.d:ro
YAML
# O processo de preparação não atende tráfego e não altera estáticos da versão ativa.
candidate_compose run -d --no-deps --name "$TEST_CONTAINER" "app-myfin-$NEXT" sh -c 'exec sleep 86400'
docker exec "$TEST_CONTAINER" python manage.py check
if docker exec "$TEST_CONTAINER" python manage.py migrate --check >/dev/null 2>&1; then
    echo 'Banco de dados já está com as migrações aplicadas.'
else
    MIGRATION_BACKUP_DIR="${MIGRATION_BACKUP_DIR:-$(dirname "$BASEDIR")/myfinance-backups}"
    mkdir -p -m 700 "$MIGRATION_BACKUP_DIR"
    MIGRATION_BACKUP_TEMP=$(mktemp "$MIGRATION_BACKUP_DIR/.before-migrations.XXXXXX")
    current_compose exec -T mysql-myfin sh -c 'export MYSQL_PWD="$MYSQL_PASSWORD"; exec mysqldump --single-transaction --no-tablespaces --set-gtid-purged=OFF -u "$MYSQL_USER" "$MYSQL_DATABASE"' > "$MIGRATION_BACKUP_TEMP"
    test -s "$MIGRATION_BACKUP_TEMP"
    MIGRATION_BACKUP_FILE="$MIGRATION_BACKUP_DIR/myfinance-before-migrations-$DEPLOY_ID.sql"
    mv "$MIGRATION_BACKUP_TEMP" "$MIGRATION_BACKUP_FILE"
    MIGRATION_BACKUP_TEMP=''
    echo "Backup do banco antes das migrações: $MIGRATION_BACKUP_FILE"
    docker exec "$TEST_CONTAINER" python manage.py migrate --noinput
    docker exec "$TEST_CONTAINER" python manage.py migrate --check
fi
docker exec "$TEST_CONTAINER" python manage.py collectstatic --no-input --verbosity 0
docker rm -f "$TEST_CONTAINER"
CANDIDATE="app-myfin-$NEXT"
candidate_compose up -d --no-deps "app-myfin-$NEXT"
echo "Validando $CANDIDATE por até ${TEST_TIMEOUT}s..."
DEADLINE=$(($(date +%s) + TEST_TIMEOUT))
READY=false
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    if [ "$(docker inspect --format '{{.State.Running}}' "$CANDIDATE")" != true ]; then break; fi
    if docker exec -i "$CANDIDATE" python - < "$BASEDIR/deploy/healthcheck.py"
    then READY=true; break; fi
    sleep 2
done
if [ "$READY" != true ]; then
    echo 'Validação falhou. A aplicação anterior continua ativa; migrations não são desfeitas.' >&2
    docker logs "$CANDIDATE" >&2 || true
    exit 1
fi
if [ "$(docker inspect --format '{{.Image}}' "$CANDIDATE")" != "$VALIDATED_IMAGE" ]; then
    echo 'A imagem iniciada difere da imagem validada.' >&2; exit 1
fi

if [ -n "$DEPLOY_IMAGE" ]; then
    sudo -n install -m 0755 "$BASEDIR/myfinance.init.d" /etc/init.d/myfinance
else
    sudo install -m 0755 "$BASEDIR/myfinance.init.d" /etc/init.d/myfinance
fi

# Na primeira adoção, muda o bind mount de arquivo para diretório.
# Preserva inicialmente o upstream legado; só troca após a preparação do proxy.
if [ "$ACTIVE" = legacy ]; then
    cp "$BASEDIR/nginx/default.conf" "$STATE/nginx/default.conf"
    mkdir -p "$STATE/assets/legacy/static"
    # Copia conteúdo e links sem tentar preservar donos dos arquivos do container.
    cp -R "$BASEDIR/static/." "$STATE/assets/legacy/static/"
    candidate_compose up -d --no-deps nginx-myfin
    # O proxy TLS resolve nginx-myfin ao carregar a configuração. A recriação
    # pode mudar seu IP na rede externa; força uma nova resolução nessa adoção.
    if [ "$(docker inspect --format '{{.State.Running}}' nginx-proxy 2>/dev/null || true)" = true ]; then
        docker exec nginx-proxy nginx -t
        docker exec nginx-proxy nginx -s reload
    fi
fi
cp "$STATE/nginx/default.conf" "$STATE/previous-nginx.conf"
sed -e "s/@UPSTREAM@/$NEXT_IP/g" -e "s/@ACTIVE@/$NEXT/g" -e "s/@PREVIOUS@/$PREVIOUS/g" \
    "$BASEDIR/nginx/bluegreen.conf.template" > "$STATE/$NEXT.nginx.conf"
cp "$STATE/$NEXT.nginx.conf" "$STATE/next-nginx.conf"
SWITCHING=true
mv "$STATE/next-nginx.conf" "$STATE/nginx/default.conf"
docker exec nginx-myfin nginx -t
# Persiste antes do reload: um reboot já encontra o novo serviço e sua imagem fixa.
printf '%s\n' "$NEXT" > "$STATE/active.next"
mv "$STATE/active.next" "$STATE/active"
docker exec nginx-myfin nginx -s reload
# Valida também o caminho pelo proxy; não basta o container responder diretamente.
DEADLINE=$(($(date +%s) + TEST_TIMEOUT))
PROXY_READY=false
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    if docker exec -i "$CANDIDATE" python - "$NEXT" < "$BASEDIR/deploy/healthcheck.py"; then
        PROXY_READY=true; break
    fi
    sleep 2
done
if [ "$PROXY_READY" != true ]; then
    echo 'O Nginx não confirmou o novo slot; revertendo a troca.' >&2; exit 1
fi
# Retira o reinício automático do antigo antes da drenagem, inclusive após reboot.
docker update --restart=no "$CURRENT_CONTAINER"
COMMITTED=true
if [ -n "$DEPLOY_IMAGE" ]; then
    printf '%s\n' "$DEPLOY_COMMIT" > "$STATE/$NEXT.commit"
    printf '%s\n' "$DEPLOY_IMAGE" > "$STATE/$NEXT.image"
else
    # Um deploy manual não deve herdar a identificação de uma imagem anterior.
    rm -f "$STATE/$NEXT.commit" "$STATE/$NEXT.image"
fi
echo "Tráfego direcionado para $NEXT. Aguardando até ${DRAIN_TIMEOUT}s pelas conexões antigas..."
# Os workers antigos do Nginx conservam requisições e WebSockets durante o reload.
DEADLINE=$(($(date +%s) + DRAIN_TIMEOUT))
while docker exec nginx-myfin sh -c 'ps | grep "[n]ginx: worker process is shutting down" >/dev/null'; do
    [ "$(date +%s)" -lt "$DEADLINE" ] || break
    sleep 2
done
docker stop -t 10 "$CURRENT_CONTAINER"
docker rm "$CURRENT_CONTAINER"
# Reinicia somente o worker, na mesma imagem da aplicação; banco e Redis permanecem.
current_compose up -d --no-deps investment-history
current_compose up -d --no-deps password-reset-email
if [ -n "$DEPLOY_IMAGE" ]; then
    printf '%s\n' "$DEPLOY_COMMIT" > "$STATE/version-registration-pending"
    if ! docker exec -i "$CANDIDATE" python - "$DEPLOY_COMMIT" < "$BASEDIR/deploy/register_version.py"; then
        echo 'Deploy concluído, mas o registro de versão falhou. Consulte .mfdeploy/version-registration-pending.' >&2
        exit 2
    fi
    rm -f "$STATE/version-registration-pending"
fi
echo "Atualização concluída. Slot ativo: $NEXT; imagem: $VALIDATED_IMAGE"
clean_docker_images
