#!/bin/sh

set -eu

BASEDIR="${BASEDIR:-/docker/myfinance}"
BKP_IMAGE="docker_myfinance_app-myfin-bkp:$(date +'%Y%m%d-%H%M%S')"
TEST_CONTAINER="myfinance-update-test-$$"
TEST_TIMEOUT="${TEST_TIMEOUT:-60}"
BACKUP_KEEP="${BACKUP_KEEP:-3}"
TEST_OVERRIDE=''

case "$TEST_TIMEOUT" in
    ''|0*|*[!0-9]*)
        echo 'TEST_TIMEOUT deve ser um número inteiro positivo.' >&2
        exit 1
        ;;
esac

case "$BACKUP_KEEP" in
    ''|0*|*[!0-9]*)
        echo 'BACKUP_KEEP deve ser um número inteiro positivo.' >&2
        exit 1
        ;;
esac

cd "$BASEDIR"
if docker compose version >/dev/null 2>&1; then
    COMPOSE_V2=true
else
    COMPOSE_V2=false
fi

compose() {
    if [ "$COMPOSE_V2" = true ]; then
        docker compose -f "$BASEDIR/docker-compose.yml" "$@"
    else
        docker-compose -f "$BASEDIR/docker-compose.yml" "$@"
    fi
}

clean_docker_images() {
    echo "Limpando Docker; mantendo o backup atual e até $BACKUP_KEEP backups no total..."

    # Os nomes têm data/hora ordenável. Sempre preserva o backup desta execução,
    # mesmo se o relógio da VM tiver mudado desde o último deploy.
    if BACKUP_TAGS=$(docker image ls \
        --filter 'reference=docker_myfinance_app-myfin-bkp:*' \
        --format '{{.Repository}}:{{.Tag}}'); then
        BACKUP_TAGS=$(printf '%s\n' "$BACKUP_TAGS" | LC_ALL=C sort -ru)
        KEPT_BACKUPS=1
        for BACKUP_TAG in $BACKUP_TAGS; do
            [ "$BACKUP_TAG" = "$BKP_IMAGE" ] && continue
            if [ "$KEPT_BACKUPS" -lt "$BACKUP_KEEP" ]; then
                KEPT_BACKUPS=$((KEPT_BACKUPS + 1))
                continue
            fi
            # Sem --force: referências em uso não devem ser forçadas à remoção.
            docker image rm "$BACKUP_TAG" || \
                echo "Aviso: não foi possível remover $BACKUP_TAG." >&2
        done
    else
        echo 'Aviso: não foi possível listar os backups antigos.' >&2
    fi

    # Não usa image prune -a, system prune ou volume prune: mantém imagens com
    # tag de outros serviços e todos os volumes, inclusive o banco de dados.
    docker builder prune -a -f || \
        echo 'Aviso: não foi possível limpar o cache de build.' >&2
    docker image prune -f || \
        echo 'Aviso: não foi possível limpar as imagens sem tag.' >&2
}

cleanup() {
    docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
    if [ -n "$TEST_OVERRIDE" ]; then
        rm -f "$TEST_OVERRIDE"
    fi
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM

# Exige o serviço atual ativo: o teste usa sua rede, banco e Redis.
CURRENT_CONTAINER=$(compose ps -q app-myfin)
if [ -z "$CURRENT_CONTAINER" ]; then
    echo 'O serviço app-myfin precisa estar em execução para validar a atualização.' >&2
    exit 1
fi
ACTUAL_IMAGE=$(docker inspect --format '{{.Image}}' "$CURRENT_CONTAINER")
docker tag "$ACTUAL_IMAGE" "$BKP_IMAGE"
echo "Backup da imagem atual: $BKP_IMAGE"

# Libera espaço antes de criar as novas camadas da imagem.
clean_docker_images

git -C myfinance pull --ff-only
compose build --no-cache app-myfin

# O container temporário compartilha a rede, mas não o IP fixo da aplicação.
TEST_OVERRIDE=$(mktemp "${TMPDIR:-/tmp}/mfupdate-compose.XXXXXX")
cat > "$TEST_OVERRIDE" <<'YAML'
services:
  app-myfin:
    networks:
      myfin-net:
        ipv4_address: ""
YAML

# Não publica portas nem inicia dependências. Evita collectstatic, que alteraria
# os arquivos estáticos compartilhados com a aplicação que ainda está no ar.
compose -f "$TEST_OVERRIDE" run -d --no-deps --name "$TEST_CONTAINER" app-myfin \
    sh -c 'python manage.py check && exec daphne -b 0.0.0.0 -p 8000 myfinance.asgi:application'

echo "Validando a nova imagem por até ${TEST_TIMEOUT}s..."
DEADLINE=$(($(date +%s) + TEST_TIMEOUT))
READY=false
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    if [ "$(docker inspect --format '{{.State.Running}}' "$TEST_CONTAINER")" != true ]; then
        break
    fi
    if docker exec -i "$TEST_CONTAINER" python - <<'PY'
import os
import http.client

os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'myfinance.settings')
import django
django.setup()
from django.conf import settings
from django.db import connection

with connection.cursor() as cursor:
    cursor.execute('SELECT 1')
    assert cursor.fetchone()[0] == 1

host = next((h.lstrip('.') for h in settings.ALLOWED_HOSTS if h != '*'), 'localhost')
client = http.client.HTTPConnection('127.0.0.1', 8000, timeout=2)
client.request('GET', '/', headers={'Host': host})
response = client.getresponse()
if not 200 <= response.status < 400:
    raise RuntimeError(f'HTTP {response.status} ao acessar /')
client.close()
PY
    then
        READY=true
        break
    fi
    sleep 2
done

if [ "$READY" != true ]; then
    echo 'Validação falhou. Os containers atuais continuam em execução.' >&2
    docker logs "$TEST_CONTAINER" >&2 || true
    exit 1
fi

# Só derruba a aplicação atual depois de validar e remover o container de teste.
docker rm -f "$TEST_CONTAINER"
echo 'Imagem validada. Reiniciando o serviço...'
sudo rc-service myfinance stop
compose down
sudo rc-service myfinance start

# Remove também o cache gerado pelo build desta atualização.
clean_docker_images
