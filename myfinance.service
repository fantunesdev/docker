[Unit]
Description=MyFinance
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=BASEDIR=/home/fernando/git/prod/docker_myfinance
ExecStart=/home/fernando/git/prod/docker_myfinance/mfcompose up -d
ExecStop=/home/fernando/git/prod/docker_myfinance/mfcompose down

[Install]
WantedBy=multi-user.target