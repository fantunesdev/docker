# Password recovery URLs carry a secret token; omit them from access logs.
map $uri $log_password_recovery {
    default 1;
    ~^/usuarios/senha/recuperar/[^/]+/[^/]+/ 0;
    ~^/usuarios/seguranca/email/confirmar/ 0;
}

# The outer proxy and VM loopback are the only published entry points.
map $http_x_forwarded_proto $original_scheme {
    default http;
    https https;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream django.myfinance.com {
    server @UPSTREAM@:8000;
}

server {
    access_log /var/log/nginx/access.log combined if=$log_password_recovery;
    listen 80;
    add_header X-Myfinance-Slot @ACTIVE@ always;
    # Endereço interno estável para clientes que usam app-myfin:8000.
    listen 8000;

    # Allow ten 10 MiB gallery photos plus multipart overhead.
    client_max_body_size 110m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $original_scheme;

    location / {
        proxy_pass http://django.myfinance.com;
    }

    location /static/ {
        root /deploy-assets;
        try_files /@ACTIVE@$uri /@PREVIOUS@$uri =404;
    }

    location /media/ {
        alias /media/;
    }

    location /ws/ {
        proxy_pass http://django.myfinance.com;
        proxy_http_version 1.1;
        # Defining Upgrade here requires repeating the other proxy headers.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $original_scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
